{
  "manifest_version": 2,
  "name": "ZenLink",
  "version": "2.0.2",
  "description": "Lets Claude Desktop control Zen Browser via local bridge server",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "<all_urls>",
    "cookies",
    "webRequest",
    "webRequestBlocking",
    "downloads",
    "clipboardRead",
    "clipboardWrite",
    "browsingData"
  ],
  "background": {
    "scripts": ["background/background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "zenlink@jayquan.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
